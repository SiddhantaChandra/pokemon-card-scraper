# Pokemon Card Tracker - Docker Environment Configuration
# Copy this file to .env to customize settings

# Database Configuration
BADGER_PATH=/data/badger
BADGER_IN_MEMORY=false

# Server Configuration
PORT=8080
DEBUG=false

# Tracker Configuration
TRACKER_ENABLED=true
TRACKER_DEVELOPMENT=false
TRACKER_SCAN_INTERVAL=1h
TRACKER_MAX_WORKERS=3
TRACKER_TIMEOUT=45s
TRACKER_ENABLE_NOTIFICATIONS=true

# Scraper Configuration
TRACKER_HEADLESS=true
TRACKER_SCRAPER_TIMEOUT=60s
TRACKER_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/91.0.4472.124 Safari/537.36

# Discord Notifications (uncomment and set your webhook URL)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1386967025133555783/VnEE5VJaBStnEQKElqk3E1qwxh7PKGAdrtRTD5WkBt268sADrsBFtIazWBCTRPbEAfzt
DISCORD_USERNAME=Pokemon Card Tracker
DISCORD_TIMEOUT=15s

# Chrome Configuration for Docker
CHROME_BIN=/usr/bin/chromium-browser
CHROME_PATH=/usr/bin/chromium-browser

# Frontend Configuration
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
BACKEND_URL=http://backend:8080 